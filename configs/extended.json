{
  "pipeline": "rf-detr-structured-equations-v2",
  "package_version": "1.11.2",
  "variant": "nano",
  "resolution": 512,
  "dataset_dir": "dataset_extended",
  "output_dir": "checkpoints/rfdetr_extended",
  "epochs": 30,
  "batch_size": 2,
  "grad_accum_steps": 4,
  "lr": 0.0001,
  "lr_encoder": 1.5e-05,
  "num_workers": 2,
  "checkpoint_interval": 1,
  "early_stopping": true,
  "early_stopping_patience": 8,
  "use_ema": true,
  "aug_config": {},
  "scale_jitter": false,
  "multi_scale": false,
  "augmentation_backend": "torchvision",
  "inference_threshold": 0.5,
  "max_symbols": 48,
  "scope": "Small expressions with fractions, square roots, digit/letter subscripts and integer superscripts; nesting up to four structural levels. No parentheses, functions or general multiline equations."
}
