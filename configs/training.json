{
  "pipeline": "rf-detr-small-equations-v1",
  "package_version": "1.11.2",
  "variant": "nano",
  "resolution": 512,
  "dataset_dir": "dataset_symbols_small",
  "output_dir": "checkpoints/rfdetr_small",
  "epochs": 30,
  "batch_size": 2,
  "grad_accum_steps": 4,
  "lr": 0.0001,
  "lr_encoder": 0.000015,
  "num_workers": 2,
  "checkpoint_interval": 1,
  "early_stopping": true,
  "early_stopping_patience": 8,
  "use_ema": true,
  "aug_config": {},
  "scale_jitter": false,
  "multi_scale": false,
  "augmentation_backend": "torchvision",
  "inference_threshold": 0.5,
  "max_symbols": 24,
  "scope": "One line: integers, x/y/z/a/b, +, -, multiplication, equality, integer superscripts. No fractions, roots, functions, parentheses or multiline layouts."
}
